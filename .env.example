# InboxMate configuration
# Copy this file to .env and fill in the values, or export them in your shell.
# This file is a template — it contains configuration NAMES only, never secrets.

# --- General ---
# A strong random secret used to sign the session/encryption keys.
# Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
INBOXMATE_SECRET_KEY=replace-me-with-a-long-random-string

# Absolute base URL of the app (used for secure cookies, links).
INBOXMATE_BASE_URL=http://localhost:8080

# Directory where SQLite data and the encryption key live.
INBOXMATE_DATA_DIR=./data

# --- Server ---
INBOXMATE_HOST=0.0.0.0
INBOXMATE_PORT=8080

# --- Auth / session ---
# Session lifetime in hours (default 168 = 7 days).
INBOXMATE_SESSION_HOURS=168
# Max login/register attempts per IP per minute.
INBOXMATE_LOGIN_RATE_LIMIT=10

# --- Email ---
# Maximum incoming email size in bytes (default 3 MB).
INBOXMATE_MAX_EMAIL_SIZE=3145728
# Maximum attachment size stored in bytes (default 10 MB).
INBOXMATE_MAX_ATTACHMENT_SIZE=10485760
# Emails shown per inbox page.
INBOXMATE_PAGE_SIZE=50
# IMAP connection timeout in seconds.
INBOXMATE_IMAP_TIMEOUT=30

# --- AI provider (optional defaults used to pre-fill the settings form) ---
# Options: none | openai | ollama
INBOXMATE_AI_PROVIDER=none
INBOXMATE_AI_BASE_URL=
INBOXMATE_AI_API_KEY=
INBOXMATE_AI_MODEL=
INBOXMATE_AI_MAX_TOKENS=1000
# Ollama default endpoint.
INBOXMATE_OLLAMA_URL=http://localhost:11434

# --- Debug (development only; never enable in production) ---
INBOXMATE_DEBUG=false

# --- Encryption ---
# Strong secret used to derive the Fernet key that encrypts stored credentials
# (IMAP/SMTP passwords, AI API keys) at rest. If unset, a key is generated and
# stored in $INBOXMATE_DATA_DIR/secret.key on first run.
INBOXMATE_ENCRYPTION_KEY=